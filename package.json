{
  "name": "@gammaswap/v2-tradingbot",
  "version": "0.1.0",
  "description": "Configurable GammaSwap V2 maker and taker trading bot for Node.js",
  "keywords": [
    "gammaswap",
    "trading",
    "trading-bot",
    "market-making",
    "ethereum",
    "base"
  ],
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xDanr/v2-tradingbot.git"
  },
  "author": "Daniel D. Alcarraz (https://github.com/0xDanr)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/0xDanr/v2-tradingbot/issues"
  },
  "homepage": "https://github.com/0xDanr/v2-tradingbot#readme",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node --env-file=./.env --loader ts-node/esm ./src/main.ts",
    "build": "pnpm clean && pnpm build:library && pnpm build:app",
    "build:library": "tsc -p tsconfig.library.json",
    "build:app": "tsc -p tsconfig.app.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "pnpm build",
    "validate:package": "pnpm build && node scripts/validate-package.mjs",
    "clean": "rm -rf dist dist-app",
    "test:watch": "vitest",
    "start": "node dist-app/main.js",
    "bot": "node --loader ts-node/esm ./src/cli.ts",
    "asset": "node --env-file=./.env --loader ts-node/esm ./scripts/sample/getAsset.ts",
    "balance": "node --env-file=./.env --loader ts-node/esm ./scripts/sample/getBalance.ts",
    "book": "node --env-file=./.env --loader ts-node/esm ./scripts/sample/getBook.ts",
    "book-top": "node --env-file=./.env --loader ts-node/esm ./scripts/sample/getBookTop.ts",
    "book-orders": "node --env-file=./.env --loader ts-node/esm ./scripts/sample/getBookOrders.ts",
    "deposit": "node --env-file=./.env --loader ts-node/esm ./scripts/sample/sendTestDepositLedgerDeposit.ts",
    "cancel": "node --env-file=./.env --loader ts-node/esm ./scripts/sample/sendTestCancel.ts",
    "order": "node --env-file=./.env --loader ts-node/esm ./scripts/sample/sendTestOrder.ts",
    "position": "node --env-file=./.env --loader ts-node/esm ./scripts/sample/getPosition.ts",
    "claim": "node --env-file=./.env --loader ts-node/esm ./scripts/sample/sendTestClaim.ts",
    "withdrawal": "node --env-file=./.env --loader ts-node/esm ./scripts/sample/sendTestWithdrawal.ts",
    "resolution": "node --env-file=./.env --loader ts-node/esm ./scripts/sample/getResolutionPrice.ts",
    "resolution:last": "node --env-file=./.env --loader ts-node/esm ./scripts/sample/getLastResolutionPrice.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "axios": "1.13.2",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "3.2.4",
    "ws": "^8.14.2"
  },
  "dependencies": {
    "@gammaswap/v2-exchange-sdk": "^0.2.3",
    "data-structure-typed": "^2.6.4",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0"
  }
}
