# Copy this file to .env.maker1, .env.maker2, or .env.maker3.
# Replace every replace-with-* value before starting the bot.

# Connection and wallet
API_URL=https://exchange-api.gammaswap.com/api
API_KEY=replace-with-api-key
API_SECRET=replace-with-api-secret
API_TIMEOUT_MS=30000
CHAIN_ID=84532
MNEMONIC=replace-with-wallet-mnemonic
WALLET_INDEX=0
ASSET_ID=replace-with-asset-id

# Contract addresses
EXCHANGE_ADDRESS=replace-with-exchange-address
LEDGER_ADDRESS=replace-with-ledger-address
SETTLEMENT_TOKEN=replace-with-settlement-token
PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
DEPOSIT_LEDGER_ADDRESS=replace-with-deposit-ledger-address

# Maker mode: passive ALO quoting only
IS_TAKER=false
LOG_LEVEL=info

# Market data
ORDERBOOK_WS_URL=wss://exchange-api.gammaswap.com/ws/
BOOK_STALE_MS=45000

# Oracle and fair value
USE_ORACLE_FAIR_VALUE=true
ORACLE_FEED_WS_URL=wss://oracle-api.gammaswap.com/ws/
ORACLE_STALE_PRICE_TIMEOUT_MS=30000
ORACLE_FIRST_PRICE_TIMEOUT_MS=30000
REQUIRE_FRESH_FAIR_VALUE=true
FAIR_VALUE_STALE_MS=45000
# Underlying annualized volatility
FAIR_VALUE_VOL=0.30
FAIR_VALUE_WEIGHT=1.0
FAIR_VALUE_PAYS_ABOVE_STRIKE=true

# Quote timing and ladder
QUOTE_LOOP_MS=5000
QUOTE_JITTER_MS=5000
LEVELS_PER_SIDE=5
LADDER_PRICE_MODEL=1
LEVEL_SPACING_NEAR=2000
LEVEL_SPACING_GROWTH=1.5
LOGIT_HALF_SPREAD=0.5

# Quote sizing; prices and sizes use protocol units
MAX_CONTRACT_EXPOSURE_PCT=5
TOTAL_SIZE_DECAY_K=2
TOTAL_SIZE_DECAY_A=0.5
TOTAL_SIZE_TIME_BUCKET_SECONDS=5
QUOTE_SIZE_CONCAVITY=1
INV_TARGET=0
INV_MAX_ABS=5000000000

# Shared risk and order limits
MAX_CAPITAL_EXPOSURE_PERCENT=70
BASE_RESERVE_MIN=1000000000
DUST_BALANCE=1000000
MAX_ORDER_SIZE=100000000000
ORDER_FAILURE_COOLDOWN_MS=5000

# Default deposit amount
DEPOSIT_AMOUNT=10000
